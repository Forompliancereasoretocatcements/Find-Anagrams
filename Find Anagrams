def find_anagrams(s, p):
    if len(s) < len(p):
        return []
    window = {}
    pdict = {}
    for i in s:
        window[i] = 0
        pdict[i] = 0
    for i in range(len(p)):
        if p[i] not in s:
            return []
        pdict[p[i]] += 1
        window[s[i]] += 1
    a = 0
    starts = []
    for char in window:
        if window[char] == pdict[char]:
            a += 1
    if a == len(window):
        starts.append(0)
    for i in range(len(s) - len(p)):
        if window[s[i]] == pdict[s[i]]:
            a -= 1
        elif window[s[i]] - 1 == pdict[s[i]]:
            a += 1
        window[s[i]] -= 1
        if window[s[i + len(p)]] == pdict[s[i + len(p)]]:
            a -= 1
        elif window[s[i + len(p)]] + 1 == pdict[s[i + len(p)]]:
            a += 1
        window[s[i + len(p)]] += 1
        if a == len(window):
            starts.append(i + 1)
    return starts

tests = [["cbaebabacd", "abc"],
         ["abab", "ab"],
         ["vcvkc", "cvv"],
         ["y", "re"],
         ["a", "k"],
         ["tisktinselletsing", "letnis"]]

for i in range(len(tests)):
    print("Test " + str(i + 1) + ":", find_anagrams(tests[i][0], tests[i][1]))

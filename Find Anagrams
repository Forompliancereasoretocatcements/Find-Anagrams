import collections

def find_anagrams(s, p):
    if len(s) < len(p):
        return []
    window = collections.Counter(s[:len(p)])
    pdict = collections.Counter(p)
    if pdict > window:
        return []
    for i in s:
        window[s] = 0
        pdict[s] = 0
    #print(window, pdict)
    a = 0
    starts = []
    for char in window:
        if window[char] == pdict[char]:
            a += 1
    if a == len(window):
        starts.append(0)
    for i in range(len(s) - len(p)):
        #if i == 6:
        #    print(window, pdict, a)
        if window[s[i]] == pdict[s[i]]:
            a -= 1
        elif window[s[i]] - 1 == pdict[s[i]]:
            a += 1
        window[s[i]] -= 1
        if  window[s[i + len(p)]] == pdict[s[i + len(p)]]:
            a -= 1
        elif window[s[i + len(p)]] + 1 == pdict[s[i + len(p)]]:
            a += 1
        window[s[i + len(p)]] += 1
        if a == len(window):
            starts.append(i + 1)
    return starts

def find_anagrams_with_improved_logic(s, p):
    if len(s) < len(p):
        return []
    p_count = collections.Counter(p)
    window_count = collections.Counter(s[:len(p)])
    starts = []
    matches = 0
    for char in p_count:
        if char in window_count and window_count[char] == p_count[char]:
            matches += 1
    if matches == len(p_count):
        starts.append(0)
    for i in range(len(p), len(s)):
        char_in = s[i]
        char_out = s[i - len(p)]
        if char_in in p_count:
            if window_count[char_in] == p_count[char_in]:
                matches -= 1
            window_count[char_in] += 1
            if window_count[char_in] == p_count[char_in]:
                matches += 1
        else:
            window_count[char_in] += 1
        if char_out in p_count:
            if window_count[char_out] == p_count[char_out]:
                matches -= 1
            window_count[char_out] -= 1
            if window_count[char_out] == p_count[char_out]:
                matches += 1
        else:
            window_count[char_out] -= 1
        if matches == len(p_count):
            starts.append(i - len(p) + 1)
    return starts


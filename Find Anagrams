import collections

def find_anagrams(s, p):
    if len(s) < len(p):
        return []
    window = collections.Counter(s[:len(p)])
    pdict = collections.Counter(p)
    if pdict > window:
        return []
    for i in s:
        window[s] = 0
        pdict[s] = 0
    print(window, pdict)
    a = 0
    starts = []
    for char in window:
        if window[char] == pdict[char]:
            a += 1
    if a == len(window):
        starts.append(0)
    for i in range(len(s) - len(p)):
        if i == 6:
            print(window, pdict, a)
        if window[s[i]] == pdict[s[i]]:
            a -= 1
        elif window[s[i]] - 1 == pdict[s[i]]:
            a += 1
        window[s[i]] -= 1
        if  window[s[i + len(p)]] == pdict[s[i + len(p)]]:
            a -= 1
        elif window[s[i + len(p)]] + 1 == pdict[s[i + len(p)]]:
            a += 1
        window[s[i + len(p)]] += 1
        if a == len(window):
            starts.append(i + 1)
    return starts

tests = [["cbaebabacd", "abc"], # [0, 6]
         ["abab", "ab"], # [0, 1, 2]
